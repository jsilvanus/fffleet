{
  "name": "fffleet-monorepo",
  "private": true,
  "description": "fffleet (fast forward fleet): run ffmpeg jobs locally, on one worker or across a pool, through one client and one job contract",
  "type": "module",
  "workspaces": [
    "packages/fffleet",
    "packages/fffleet-worker",
    "packages/fffleet-orchestrator"
  ],
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm test --workspaces && npm run test:types",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.e2e.test.js",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "changeset publish",
    "test:types": "tsc -p test/types"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "EUPL-1.2",
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
