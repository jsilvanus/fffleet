# Copy to /home/pi/apps/fffleet-orchestrator/orchestrator.env and chmod 600.
PORT=5000
HOST=0.0.0.0
FFFLEET_CONFIG=/home/pi/apps/fffleet-orchestrator/fffleet.yaml
# Jobs survive a restart (needs Node 22.13+; the Pi has Node 24).
FFFLEET_STATE_FILE=/home/pi/apps/fffleet-orchestrator/state.sqlite
# Token apps use to submit jobs, and token the workers register with. Generate with: openssl rand -hex 24
FFFLEET_TOKEN=change-me
FFFLEET_WORKER_TOKEN=change-me-too
