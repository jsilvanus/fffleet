# Worker env, one per machine. Copy and edit; see docs/worker-roles.md.
FFFLEET_ORCHESTRATOR_URL=http://192.168.1.78:5000      # on the Pi itself: http://127.0.0.1:5000
FFFLEET_WORKER_TOKEN=change-me-too                     # same as in orchestrator.env
FFFLEET_WORKER_ID=pi                                   # pi | operator-pc | assisting-pc (must stay stable)
FFFLEET_CAPABILITIES=usb,normal                        # pi: usb,normal  operator-pc: normal,dsk,gpu  assisting-pc: normal
FFFLEET_SLOTS=2                                        # keep low on the Pi 4
# Advertise a url the orchestrator can reach (needed when the worker is not on the Pi):
# FFFLEET_ADVERTISE_URL=http://192.168.1.98:4000
# Only advertise "normal" while MediaMTX answers from this machine:
# FFFLEET_PROBE=mediamtx=192.168.1.78:8554
